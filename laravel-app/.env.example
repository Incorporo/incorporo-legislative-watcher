APP_NAME="Romanian Legislative Watcher"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
# Note: SQLite PDO driver may not be available in all environments
# Use MySQL or PostgreSQL for production

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=legislative_watcher
DB_USERNAME=root
DB_PASSWORD=

# IMPORTANT: Override any system DATABASE_URL environment variable
# This prevents conflicts with other projects or system-wide database URLs
DATABASE_URL=

# For PostgreSQL, use:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=legislative_watcher
# DB_USERNAME=postgres
# DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Scraper Settings
SCRAPER_USER_AGENT="Mozilla/5.0 (compatible; RomanianLegislativeWatcher/1.0)"
SCRAPER_DELAY_SECONDS=3
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_MAX_RETRIES=3

# Proxy Settings (for bypassing anti-bot protection)
# Enable proxy: set to true
SCRAPER_PROXY_ENABLED=false
# Single proxy or multiple proxies (comma-separated)
# Format: http://username:password@host:port or http://host:port
# Example: SCRAPER_PROXY="http://user:pass@proxy1.com:8080,http://proxy2.com:8080"
SCRAPER_PROXY=
# Enable proxy rotation (if multiple proxies provided)
SCRAPER_PROXY_ROTATION=true

# Selenium WebDriver Settings (alternative to proxies)
# Requires Chrome/Chromium browser installation
# See SCRAPER_SETUP_GUIDE.md for installation instructions
SELENIUM_ENABLED=false
SELENIUM_URL=http://localhost:4444
SELENIUM_HEADLESS=true

# CDEP Settings
CDEP_BASE_URL=https://www.cdep.ro

# Senate Settings
SENATE_BASE_URL=https://www.senat.ro

# OpenRouter AI Settings
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_TEMPERATURE=0.7
